# ==========================================
# Laravel & Archivos de Compilación
# ==========================================
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
/bootstrap/cache/*.php

# ==========================================
# Variables de Entorno y Credenciales
# ==========================================
.env
.env.*
!.env.example
/auth.json

# ==========================================
# PhpStorm + Autocompletado de Laravel
# ==========================================
/.idea
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php

# ==========================================
# Otros Editores
# ==========================================
/.vscode
/.fleet
/.zed

# ==========================================
# Base de Datos Local
# ==========================================
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# ==========================================
# Caché de Pruebas y Herramientas de Código
# ==========================================
.phpunit.result.cache
/.phpunit.cache
/.pest
.pint.cache
.php-cs-fixer.cache

# ==========================================
# Logs, Depuración y Docker
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
docker-compose.override.yml

# ==========================================
# Archivos del Sistema Operativo
# ==========================================
.DS_Store
._*
Thumbs.db
Ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*~
