# ==========================================
# Normalización de saltos de línea
# ==========================================
* text=auto eol=lf

# ==========================================
# Estadísticas de GitHub (PHP + Blade + JS/CSS propio)
# ==========================================
public/** linguist-vendored
*.min.css linguist-generated
*.min.js linguist-generated
*.map linguist-generated
*.php linguist-detectable=true
*.blade.php linguist-detectable=true
resources/js/** linguist-detectable=true
resources/css/** linguist-detectable=true

# ==========================================
# Lectura de cambios (Diffs)
# ==========================================
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# ==========================================
# Ignorar al descargar el repo en .ZIP
# ==========================================
/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
